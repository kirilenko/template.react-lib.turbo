{
  "name": "template-react-lib-turbo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "check": "turbo run lint typecheck lint:package && prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .prettierignore",
    "release": "semantic-release",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "turbo": "^2.11.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "typescript-native": "npm:typescript@^7.0.2"
  },
  "engines": {
    "node": "^22.14.0 || >=24.10.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "overrides": {
      "handlebars": "^4.7.10",
      "glob": "^14.0.2",
      "minimatch": "^11.0.1"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
